# ===== 服务 =====
SERVER_PORT=9090
# 允许跨域的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
TRUSTED_PROXIES=127.0.0.1,::1

# ===== 数据库 =====
# 方式一：MySQL（与 Go 版共用同一个库，表结构完全兼容）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=blog
# 方式二：直接用 DSN 覆盖（本地零依赖跑通）
# DATABASE_URL=sqlite+aiosqlite:///./data/blog.db

# ===== Redis（不配置则缓存自动降级，功能不受影响）=====
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== JWT =====
# 生产环境务必修改；访客指纹的 HMAC 密钥也复用它
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=168

# ===== 博主身份（后台鉴权的唯一依据，前端不可伪造）=====
BLOGGER_USER_ID=1
BLOGGER_USERNAME=admin
BLOGGER_PASSWORD=admin123456
BLOGGER_NICKNAME=博主
BLOGGER_EMAIL=blogger@example.com
BLOGGER_AVATAR=/avatar.jpg

# ===== 邮件通知（可选，留空则跳过发信）=====
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=博客评论通知
EMAIL_FROM_EMAIL=

# ===== 应用 =====
UPLOAD_DIR=uploads
APP_SEED_DATA=true
LOG_LEVEL=info
LOG_FILENAME=logs/app.log
